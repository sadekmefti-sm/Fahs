rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInspectionBackup(data, userId) {
      let requiredFields = [
        'userId', 'localId', 'carBrand', 'carModel', 'carGeneration',
        'carYear', 'fuelType', 'gearboxType', 'engineDescription',
        'vin', 'plateNumber', 'inspectionMode', 'status', 'overallScore',
        'verdict', 'totalEstimatedCostDzd', 'problemCount',
        'answeredQuestions', 'totalQuestions', 'notes', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(requiredFields)
          && data.keys().hasOnly(requiredFields)
          && data.userId is string && data.userId == userId
          && data.localId is int && data.localId >= 0
          && data.carBrand is string && data.carBrand.size() >= 1 && data.carBrand.size() <= 80
          && data.carModel is string && data.carModel.size() >= 1 && data.carModel.size() <= 80
          && data.carGeneration is string && data.carGeneration.size() <= 100
          && data.carYear is int && data.carYear >= 1970 && data.carYear <= 2035
          && data.fuelType is string && data.fuelType.size() >= 1 && data.fuelType.size() <= 40
          && data.gearboxType is string && data.gearboxType.size() >= 1 && data.gearboxType.size() <= 50
          && data.engineDescription is string && data.engineDescription.size() <= 100
          && data.vin is string && data.vin.size() <= 30
          && data.plateNumber is string && data.plateNumber.size() <= 40
          && data.inspectionMode in ['QUICK', 'FULL']
          && data.status in ['IN_PROGRESS', 'COMPLETED']
          && data.overallScore is int && data.overallScore >= -1 && data.overallScore <= 100
          && data.verdict in ['GOOD', 'NEGOTIATE', 'AVOID', 'INCOMPLETE']
          && data.totalEstimatedCostDzd is int && data.totalEstimatedCostDzd >= 0 && data.totalEstimatedCostDzd <= 50000000
          && data.problemCount is int && data.problemCount >= 0 && data.problemCount <= 500
          && data.answeredQuestions is int && data.answeredQuestions >= 0 && data.answeredQuestions <= 500
          && data.totalQuestions is int && data.totalQuestions >= 0 && data.totalQuestions <= 500
          && data.notes is string && data.notes.size() <= 2000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /users/{userId}/inspections/{inspectionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId)
                    && isValidId(inspectionId)
                    && isValidInspectionBackup(request.resource.data, userId)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
                    && isValidId(inspectionId)
                    && isValidInspectionBackup(request.resource.data, userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    match /shop_settings/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }
  }
}
