{
  "entities": {
    "CloudInspectionBackup": {
      "title": "CloudInspectionBackup",
      "description": "Private cloud backup of a user's used-car inspection report in Fahs",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the inspection owner"
        },
        "localId": {
          "type": "integer",
          "description": "Local Room primary key id of the inspection"
        },
        "carBrand": {
          "type": "string",
          "description": "Car brand name (e.g., Renault, Peugeot, Dacia)"
        },
        "carModel": {
          "type": "string",
          "description": "Car model name (e.g., Symbol, 208, Duster)"
        },
        "carGeneration": {
          "type": "string",
          "description": "Generation or trim label"
        },
        "carYear": {
          "type": "integer",
          "description": "Manufacturing year"
        },
        "fuelType": {
          "type": "string",
          "description": "Fuel type (ESSENCE, DIESEL, GPL, HYBRIDE)"
        },
        "gearboxType": {
          "type": "string",
          "description": "Transmission type (MANUELLE, AUTOMATIQUE)"
        },
        "engineDescription": {
          "type": "string",
          "description": "Engine code or displacement"
        },
        "vin": {
          "type": "string",
          "description": "17-character Vehicle Identification Number"
        },
        "plateNumber": {
          "type": "string",
          "description": "Algerian registration plate number"
        },
        "inspectionMode": {
          "type": "string",
          "description": "QUICK or FULL",
          "enum": [
            "QUICK",
            "FULL"
          ]
        },
        "status": {
          "type": "string",
          "description": "IN_PROGRESS or COMPLETED",
          "enum": [
            "IN_PROGRESS",
            "COMPLETED"
          ]
        },
        "overallScore": {
          "type": "integer",
          "description": "Inspection score from 0 to 100, or -1 if incomplete"
        },
        "verdict": {
          "type": "string",
          "description": "GOOD, NEGOTIATE, AVOID, or INCOMPLETE",
          "enum": [
            "GOOD",
            "NEGOTIATE",
            "AVOID",
            "INCOMPLETE"
          ]
        },
        "totalEstimatedCostDzd": {
          "type": "integer",
          "description": "Total estimated repair cost in Algerian Dinars"
        },
        "problemCount": {
          "type": "integer",
          "description": "Number of problems found"
        },
        "answeredQuestions": {
          "type": "integer",
          "description": "Number of checklist items answered"
        },
        "totalQuestions": {
          "type": "integer",
          "description": "Total checklist items in the inspection"
        },
        "notes": {
          "type": "string",
          "description": "Summary notes and diagnostic findings"
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "timestamp",
          "description": "Last cloud backup timestamp"
        }
      },
      "required": [
        "userId",
        "localId",
        "carBrand",
        "carModel",
        "carGeneration",
        "carYear",
        "fuelType",
        "gearboxType",
        "engineDescription",
        "vin",
        "plateNumber",
        "inspectionMode",
        "status",
        "overallScore",
        "verdict",
        "totalEstimatedCostDzd",
        "problemCount",
        "answeredQuestions",
        "totalQuestions",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShopSettings": {
      "title": "ShopSettings",
      "description": "Public read-only configuration document containing WhatsApp number, contact email, dongle price, stock availability, and wilaya delivery fees",
      "type": "object",
      "properties": {
        "whatsappNumber": {
          "type": "string",
          "description": "Official WhatsApp phone number for dongle orders"
        },
        "contactEmail": {
          "type": "string",
          "description": "Official contact email address"
        },
        "donglePriceDzd": {
          "type": "integer",
          "description": "Price of the ELM327 dongle in DZD"
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether the dongle is currently in stock"
        },
        "deliveryFees": {
          "type": "array",
          "description": "List of wilaya delivery fees for home and stop-desk delivery"
        }
      },
      "required": [
        "whatsappNumber",
        "contactEmail",
        "donglePriceDzd",
        "inStock"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/inspections/{inspectionId}": {
      "schema": {
        "$ref": "#/entities/CloudInspectionBackup"
      },
      "description": "User-scoped private collection of backed-up vehicle inspections"
    },
    "/shop_settings/{docId}": {
      "schema": {
        "$ref": "#/entities/ShopSettings"
      },
      "description": "Public read-only shop and contact settings managed via the Firebase Console"
    }
  }
}
